# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Google Gemini API (used for extracting briefs and for the chatbot)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Optional: a second model to fall back on if the first is busy or retired
GEMINI_FALLBACK_MODEL=

# MySQL
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=rag_system
